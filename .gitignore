# Environment and secrets — never commit these
.env
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Runtime log files — these grow with traffic and belong in a log shipper, not git
logs/*.log
logs/*.jsonl

# Fine-tuned model weights — large binary files that live outside git.
# The baseline metrics (metrics/baseline.json) ARE committed; the weights are not.
model/

# HuggingFace model cache downloaded during Docker build or local runs
.cache/

# Test output
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
